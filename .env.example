# Paths are resolved relative to server/ unless absolute.
HOST=127.0.0.1
PORT=4174
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=../.data
MAX_UPLOAD_BYTES=1073741824
MAX_CONCURRENT_UPLOADS=2
UPLOAD_TIMEOUT_MS=7200000
SESSION_HOURS=24
# Optional MEGA backend
# MEGA_RCLONE_REMOTE=blackbox-mega:BlackboxStore
# MEGA_RCLONE_CONFIG=D:/Private/Blackbox-rclone.conf
# MEGA_RCLONE_EXECUTABLE=rclone
# Optional Telegram MTProto client install directory
# TELEGRAM_CLIENT_DIR=C:/Users/Example/AppData/Local/BlackboxStore/telegram
# Optional server-side Google sign-in
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_TYPE=web
# Optional TeraBox Open Platform application
# TERABOX_CLIENT_ID=
# TERABOX_CLIENT_SECRET=
# TERABOX_PRIVATE_SECRET=
# TERABOX_APP_FOLDER=
